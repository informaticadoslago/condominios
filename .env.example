#{1=Nombre+apellidos, 2=apellidos,Nombre}
LIST_NOMBRECOMPLETO=1

SUPERADMIN_EMAIL="admin@ejemplo.com"
SUPERADMIN_LOGIN=superadmin

SAVE_USER_LAST_SEEN=true

TRANSLATIONS_PROVIDER=dummy
# Documentos adjuntos: carpeta relativa a storage/ (en L9 era app/documentos).
DOCUMENTOS_ROOT=app/documentos

# Exportaciones de comunidad (condominios:comunidad-exportar): carpeta relativa a storage/.
COMS_ROOT=app/coms

# Análisis de facturas: 'pdftotext' (binario poppler-utils), 'pdfparser' (librería PHP
# pura) o 'pdfplumber' (Python, vía storage/app/pyenv).
FACTURAS_LECTOR_PDF=pdftotext

# "Generar plantilla con IA": clave de console.anthropic.com (Créditos de la
# organización, NO los créditos de uso de claude.ai). Sin esta clave, ese botón
# da error pero el resto de la app funciona igual.
# ANTHROPIC_API_KEY=
# FACTURAS_IA_MODELO=claude-haiku-4-5-20251001

# {false=Enter activa el botón por defecto, true=Enter/flechas izda-dcha saltan de campo}
RLAU_TAB_STYLE=false

# Avisos por correo de los recibos. Con estas a false no sale el botón de avisar en
# la pantalla correspondiente; los avisos nunca se mandan solos, siempre hay que
# pulsar.
ENVIAR_EMAIL_AL_ENVIAR_REMESA=false
ENVIAR_EMAIL_TRANSFERENCIAS=false
