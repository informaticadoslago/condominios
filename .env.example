APP_NAME="Condominios dosLago"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://condominios.virtual.lago
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid


SERVER_CONTABILIDAD=condominios.virtual.lago
SERVER_XESTION=condominios.virtual.lago

SERVER_TEST_COLOR="bg-warning"

LOG_CHANNEL=daily
LOG_LEVEL=debug

APP_LOG_LEVEL=debug
APP_LOG=daily
ARCANEDEV_LOGVIEWER_MIDDLEWARE="web" 
# ,permission:log-viewer-admin"

LOGO_TEXT="<b>dosLago</b>"
LOGO_IMG="images/logo.jpg"
LOGO_ALT="informaticadlago"

MENU_HEADER="MENU PRINCIPAL"

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

DB_DATABASE=CondominiosDosLago
DB_USERNAME=CondominiosDosLago
DB_PASSWORD=CondominiosDosLagoPass

# Conexión de pruebas separada. PHPUnit puede apuntar aquí para usar otra cuenta
# contra la base _test sin tocar la conexión normal.
# DB_TEST_DATABASE=CondominiosDosLago_test
# DB_TEST_USERNAME=root
# DB_TEST_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file

# QUEUE_CONNECTION=sync
QUEUE_CONNECTION=database

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Minutos que dura la cookie de "recuérdame" (autologin). 30 días.
AUTH_REMEMBER_LIFETIME=43200

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# usuario sinrespuesta.alagoro@gmail.com
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=8f2aa188aa1f3f
MAIL_PASSWORD=f08cf1f39e4f04
MAIL_ENCRYPTION=tls


MAIL_FROM_NAME="Mensaje automatico (No responder)"
MAIL_FROM_ADDRESS="sinrespuesta.alagoro@gmail.com"
EMAIL_FIRMA="Equipo condominios dosLago"
EMAIL_FACTURA_FIRMA="Equipo administrativo condominios dosLago"
EMAIL_SANDBOX=false
EMAIL_SANDBOX_TO=

# TICKETPRINTER_IP=
# TICKETPRINTER_PORT = 9100
TICKETPRINTER_IMPRIMIR_AL_GRABAR=false

ENVIAR_EMAIL_AL_CREAR_FACTURA=false
ENVIAR_EMAIL_AL_CREAR_BOLETIN=false

TRACK_LOGIN = true
TRACK_NEW_USER_REGISTRATION=false

